      "border": { "$type": "color", "$value": "#29313A" },
      "foreground": { "$type": "color", "$value": "#B7C0C8" },
      "strong": { "$type": "color", "$value": "#ECF0F2" },
      "dim": { "$type": "color", "$value": "#687581" },
      "cursor": { "$type": "color", "$value": "{color.primitive.lime-500}" },
      "selection": { "$type": "color", "$value": "#C8F24C26" },
      "success": { "$type": "color", "$value": "{color.primitive.terminal-green}" },
      "warning": { "$type": "color", "$value": "{color.primitive.terminal-amber}" },
      "error": { "$type": "color", "$value": "{color.primitive.terminal-red}" },
      "info": { "$type": "color", "$value": "{color.primitive.terminal-blue}" }
