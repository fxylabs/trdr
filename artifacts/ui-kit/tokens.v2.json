      "xs": { "$type": "dimension", "$value": "10px" },
      "sm": { "$type": "dimension", "$value": "11px" },
      "md": { "$type": "dimension", "$value": "12px" },
      "lg": { "$type": "dimension", "$value": "14px" },
      "xl": { "$type": "dimension", "$value": "18px" },
      "2xl": { "$type": "dimension", "$value": "22px" },
      "3xl": { "$type": "dimension", "$value": "27px" },
      "display": { "$type": "dimension", "$value": "39px" }
    },
    "weight": {
      "regular": { "$type": "number", "$value": 500 },
      "medium": { "$type": "number", "$value": 600 },
      "semibold": { "$type": "number", "$value": 680 },
      "bold": { "$type": "number", "$value": 760 },
      "brand": { "$type": "number", "$value": 850 }
