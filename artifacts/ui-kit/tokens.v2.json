      "body": { "$type": "number", "$value": 1.45 },
      "terminal": { "$type": "number", "$value": 1.5 }
    },
    "tracking": {
      "ui": { "$type": "dimension", "$value": "-0.012em" },
      "number": { "$type": "dimension", "$value": "-0.025em" },
      "display": { "$type": "dimension", "$value": "-0.05em" },
      "label": { "$type": "dimension", "$value": "0.08em" }
