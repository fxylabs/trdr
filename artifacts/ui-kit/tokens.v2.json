      "amber-500": { "$type": "color", "$value": "#A96D17" },
      "terminal-red": { "$type": "color", "$value": "#DC726B" },
      "terminal-green": { "$type": "color", "$value": "#70BF9B" },
      "terminal-amber": { "$type": "color", "$value": "#D5A451" },
      "terminal-blue": { "$type": "color", "$value": "#72A8DF" },
