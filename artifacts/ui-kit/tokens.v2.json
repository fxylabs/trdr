  "size": {
    "control-sm": { "$type": "dimension", "$value": "28px" },
    "control-md": { "$type": "dimension", "$value": "36px" },
    "row-compact": { "$type": "dimension", "$value": "39px" },
    "row-data": { "$type": "dimension", "$value": "52px" },
    "topbar": { "$type": "dimension", "$value": "42px" },
    "terminal-title": { "$type": "dimension", "$value": "38px" },
    "terminal-status": { "$type": "dimension", "$value": "26px" },
    "sidebar": { "$type": "dimension", "$value": "196px" },
    "agent-rail": { "$type": "dimension", "$value": "420px" },
    "desktop-width": { "$type": "dimension", "$value": "1440px" },
    "desktop-height": { "$type": "dimension", "$value": "900px" }
  },
  "radius": {
    "xs": { "$type": "dimension", "$value": "4px" },
    "sm": { "$type": "dimension", "$value": "6px" },
    "md": { "$type": "dimension", "$value": "9px" },
    "lg": { "$type": "dimension", "$value": "11px" },
    "round": { "$type": "dimension", "$value": "999px" }
  },
  "border": {
    "hairline": { "$type": "dimension", "$value": "1px" },
    "focus": { "$type": "dimension", "$value": "2px" }
  },
  "shadow": {
    "surface": { "$type": "shadow", "$value": { "color": "#171C2208", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" } },
    "floating": { "$type": "shadow", "$value": { "color": "#0E14195C", "offsetX": "0px", "offsetY": "24px", "blur": "80px", "spread": "0px" } },
    "terminal": { "$type": "shadow", "$value": { "color": "#0F141914", "offsetX": "-10px", "offsetY": "0px", "blur": "28px", "spread": "0px" } }
  },
  "motion": {
    "instant": { "$type": "duration", "$value": "0ms" },
    "fast": { "$type": "duration", "$value": "120ms" },
    "standard": { "$type": "duration", "$value": "180ms" },
    "slow": { "$type": "duration", "$value": "260ms" },
    "easing-standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] }
  },
  "layer": {
    "base": { "$type": "number", "$value": 0 },
    "sticky": { "$type": "number", "$value": 10 },
