{
    "name": "trdr",
    "version": "0.0.0",
    "description": "Local-first trading research terminal for macOS (pre-release)",
    "homepage": "https://github.com/fxylabs/trdr",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fxylabs/trdr.git"
    },
    "bugs": {
        "url": "https://github.com/fxylabs/trdr/issues"
    },
    "license": "AGPL-3.0-only",
    "private": true,
    "packageManager": "pnpm@10.33.0",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "build": "pnpm --recursive build",
        "dev": "pnpm --filter @trdr/desktop dev",
        "typecheck": "pnpm --recursive typecheck",
        "test": "pnpm --recursive test"
    }
}
