{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "trdr-spike-keychain-kis",
    "version": "0.0.0",
    "identifier": "com.fxylabs.trdr.spike.keychain-kis",
    "build": {
        "frontendDist": "../ui"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "label": "main",
                "title": "trdr Keychain/KIS spike",
                "width": 980,
                "height": 720
            }
        ],
        "security": {
            "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
        }
    },
    "bundle": {
        "active": false
    }
}
