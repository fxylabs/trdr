{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "trdr-spike-pty",
    "version": "0.0.0",
    "identifier": "com.fxylabs.trdr.spike.pty",
    "build": {
        "beforeDevCommand": "pnpm dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "pnpm build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "trdr PTY spike",
                "width": 1200,
                "height": 800
            }
        ],
        "security": {
            "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
        }
    },
    "bundle": {
        "active": false
    }
}
